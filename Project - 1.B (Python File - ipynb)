    "# Loading contracts.csv\n",
    "contracts_df = pd.read_csv(base_path + \"contracts.csv\")\n",
    "\n",
    "# Renaming columns to match table\n",
    "contracts_df.rename(columns={\n",
    "    'Contract_Id': 'id',\n",
    "    'drug': 'drug_name',\n",
    "    'pharm_company_id': 'company_id'\n",
    "}, inplace=True)\n",
    "\n",
    "# Fixing date format\n",
    "contracts_df['date'] = pd.to_datetime(contracts_df['date'], errors='coerce').dt.strftime('%Y-%m-%d')\n",
    "contracts_df = contracts_df.dropna(subset=['date'])\n",
    "\n",
    "# Ensuring types\n",
    "contracts_df = contracts_df.astype({\n",
    "    'id': int,\n",
    "    'company_id': int,\n",
    "    'pharmacy_id': int,\n",
    "    'drug_name': str,\n",
    "    'dosage': str,\n",
    "    'quantity': int,\n",
    "    'price': float,\n",
    "    'date': str\n",
    "})\n",
    "\n",
    "# Filtering invalid foreign keys (drugs, pharmacies, companies)\n",
    "# Get valid drugs\n",
    "mycursor.execute(\"SELECT name FROM drugs\")\n",
    "valid_drugs = {row[0] for row in mycursor.fetchall()}\n",
    "contracts_df = contracts_df[contracts_df['drug_name'].isin(valid_drugs)]\n",
    "\n",
    "# Getting valid pharmacy IDs\n",
    "mycursor.execute(\"SELECT id FROM pharmacies\")\n",
    "valid_pharmacy_ids = {row[0] for row in mycursor.fetchall()}\n",
    "contracts_df = contracts_df[contracts_df['pharmacy_id'].isin(valid_pharmacy_ids)]\n",
    "\n",
    "# Getting valid company IDs\n",
    "mycursor.execute(\"SELECT id FROM companies\")\n",
    "valid_company_ids = {row[0] for row in mycursor.fetchall()}\n",
    "contracts_df = contracts_df[contracts_df['company_id'].isin(valid_company_ids)]\n",
    "\n",
    "# Inserting into contracts\n",
    "for _, row in contracts_df.iterrows():\n",
    "    sql = \"\"\"\n",
    "    INSERT INTO contracts (id, company_id, pharmacy_id, drug_name, dosage, quantity, date, price)\n",
    "    VALUES (%s, %s, %s, %s, %s, %s, %s, %s)\n",
    "    \"\"\"\n",
    "    mycursor.execute(sql, (\n",
    "        row['id'],\n",
    "        row['company_id'],\n",
    "        row['pharmacy_id'],\n",
    "        row['drug_name'],\n",
    "        row['dosage'],\n",
    "        row['quantity'],\n",
    "        row['date'],\n",
    "        row['price']\n",
    "    ))\n",
    "\n",
    "mydb.commit()\n",
    "print(\"Contracts table populated successfully.\")\n"
