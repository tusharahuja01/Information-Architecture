    "mycursor.execute(\"SELECT id FROM prescriptions\")\n",
    "valid_prescription_ids = {row[0] for row in mycursor.fetchall()}\n",
    "\n",
    "# Filtering only rows with valid foreign keys\n",
    "fills_df = fills_df[\n",
    "    fills_df['pharmacy_id'].isin(valid_pharmacy_ids) &\n",
    "    fills_df['prescription_id'].isin(valid_prescription_ids)\n",
