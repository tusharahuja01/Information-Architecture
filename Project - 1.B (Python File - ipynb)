    "from datetime import datetime\n",
    "\n",
    "# Defining the date cleaning function\n",
    "def clean_birth_date(date_str):\n",
    "    try:\n",
    "        return datetime.fromisoformat(date_str.replace(\"Z\", \"\")).date()\n",
    "    except Exception as e:\n",
    "        print(f\"⚠️ Invalid date format for value: {date_str}\")\n",
    "        return None\n",
    "\n",
    "# Building mapping from physicians table (ssn → physician_id)\n",
    "mycursor.execute(\"SELECT physician_id, ssn FROM physicians\")\n",
    "physician_lookup = {ssn: pid for pid, ssn in mycursor.fetchall()}\n",
    "\n",
    "# Loading patients CSV and insert with cleaned date and mapped physician_id\n",
    "patients_df = pd.read_csv(base_path + \"patients.csv\")\n",
    "\n",
    "for _, row in patients_df.iterrows():\n",
    "    birth_date_clean = clean_birth_date(row['birthdate'])\n",
    "\n",
    "    # Mapping physician SSN from CSV to real physician_id from DB\n",
    "    mapped_physician_id = physician_lookup.get(row['physician_id'])\n",
    "\n",
    "    if birth_date_clean and mapped_physician_id:\n",
    "        sql = \"INSERT INTO patients (ssn, name, address, birth_date, physician_id) VALUES (%s, %s, %s, %s, %s)\"\n",
    "        values = (\n",
    "            row['ssn'],\n",
    "            row['name'],\n",
    "            row['address'],\n",
    "            birth_date_clean,\n",
    "            mapped_physician_id\n",
    "        )\n",
    "        mycursor.execute(sql, values)\n",
    "    else:\n",
    "        print(f\"Skipped due to bad date or missing physician: {row.to_dict()}\")\n",
    "\n",
    "mydb.commit()\n",
    "print(\"Patients table populated successfully.\")\n"
   ]
