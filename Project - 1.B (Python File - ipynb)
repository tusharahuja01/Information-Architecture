    "\n",
    "# Converting columns to native Python types\n",
    "fills_df = fills_df.astype({\n",
    "    'pharmacy_id': 'int',\n",
    "    'prescription_id': 'int',\n",
    "    'cost': 'float',\n",
    "    'date': 'string'\n",
    "})\n",
    "\n",
    "# Inserting data\n",
    "inserted_rows = 0\n",
    "for _, row in fills_df.iterrows():\n",
    "    try:\n",
    "        mycursor.execute(\n",
    "            \"INSERT INTO pharmacy_fills (prescription_id, pharmacy_id, date, cost) VALUES (%s, %s, %s, %s)\",\n",
    "            (\n",
    "                int(row['prescription_id']),\n",
    "                int(row['pharmacy_id']),\n",
    "                str(row['date']),\n",
    "                float(row['cost'])\n",
    "            )\n",
    "        )\n",
    "        inserted_rows += 1\n",
    "    except mysql.connector.Error as err:\n",
    "        print(f\"⚠️ Skipped row due to error: {err}\")\n",
    "\n",
    "mydb.commit()\n",
    "print(f\"Inserted {inserted_rows} rows into pharmacy_fills successfully.\")\n"
